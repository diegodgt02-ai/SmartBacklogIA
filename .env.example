# Copiar a .env y ajustar. Nunca commitear .env.
DATABASE_URL=postgresql+psycopg://spb:spb@localhost:5432/spb
SESSION_SECRET=cambiar-por-un-valor-largo-aleatorio
# Opcional: el sistema hace POST aquí cuando una HU entra a refinamiento
ADK_WEBHOOK_URL=
# Usado sólo por scripts/seed.py
SEED_ADMIN_EMAIL=admin@spb.local
SEED_ADMIN_PASSWORD=cambiar-me-ya

# --- Agentes IA ---
# none (desactivado) | stub (sin LLM, para pruebas) | adk (Gemini con Google ADK)
AGENT_PROVIDER=none
# Gemini Pro: confirma el id exacto con `python scripts/try_agent.py --list-models`
AGENT_MODEL=gemini-3.1-pro-preview
# Clave de Gemini API / Google AI Studio (cuenta empresarial). Nunca la commitees.
GOOGLE_API_KEY=
# background (en segundo plano) | inline (espera el resultado; útil para pruebas)
AGENT_EXECUTION=background
# true: al pasar una HU a en_refinamiento el agente interno la refina
AGENT_AUTO_REFINE=false
AGENT_MAX_DOC_CHARS=200000
# Opcional: precio por millón de tokens para estimar el costo en agent_runs
AGENT_PRICE_IN_PER_1M=
AGENT_PRICE_OUT_PER_1M=
